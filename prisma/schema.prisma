generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  priceInCents Int
  imageUrl     String
  stock        Int      @default(10)
  createdAt    DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  totalInCents    Int
  status          OrderStatus @default(PENDING)
  items           String
  createdAt       DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}
